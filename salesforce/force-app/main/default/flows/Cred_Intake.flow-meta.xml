    <description>POC intake: New/Recred + Path, create Application and checklist from subject-type templates.</description>
    <formulas>
        <name>fx_App_External_Id</name>
        <dataType>String</dataType>
        <expression>LEFT({!Get_Provider.External_Id__c} &amp; &quot;-&quot; &amp; SUBSTITUTE({!$Flow.InterviewGuid}, &quot;-&quot;, &quot;&quot;), 40)</expression>
    </formulas>
    <formulas>
        <name>fx_Item_Key</name>
        <dataType>String</dataType>
        <expression>LOWER(SUBSTITUTE(SUBSTITUTE({!Loop_Template_Keys}, &quot; &quot;, &quot;_&quot;), &quot;/&quot;, &quot;_&quot;))</expression>
    </formulas>
    <formulas>
        <name>fx_Checklist_External_Id</name>
        <dataType>String</dataType>
        <expression>LEFT({!varApplication.External_Id__c} &amp; &quot;-&quot; &amp; TEXT({!varSortOrder}), 40)</expression>
    </formulas>
