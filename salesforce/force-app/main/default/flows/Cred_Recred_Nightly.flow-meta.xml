<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Build_Recred_App</name>
        <label>Build Recred Application</label>
        <locationX>264</locationX>
        <locationY>755</locationY>
        <assignmentItems>
            <assignToReference>varNewApp.Provider__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Providers.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewApp.Subject_Type__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Providers.Subject_Type__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewApp.Application_Type__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Recred</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewApp.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Draft</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewApp.Attempt_Count__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewApp.Path__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fx_Default_Path</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewApp.External_Id__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fx_Recred_External_Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewApp.Due_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Providers.Recred_Due_Date__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Recred_App</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Has_Open_Recred</name>
        <label>Has Open Recred App?</label>
        <locationX>396</locationX>
        <locationY>647</locationY>
        <defaultConnector>
            <targetReference>Build_Recred_App</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Open Recred — Create</defaultConnectorLabel>
        <rules>
            <name>Open_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Open_Recred</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Providers</targetReference>
            </connector>
            <label>Open Recred Exists</label>
        </rules>
    </decisions>
    <description>Daily: providers with Recred Due within 120 days and no open Recred application get a Draft Recred Application.</description>
    <formulas>
        <name>fx_Due_Horizon</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 120</expression>
    </formulas>
    <formulas>
        <name>fx_Default_Path</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!Loop_Providers.Subject_Type__c}) = &quot;Facility&quot;, &quot;Facility&quot;, &quot;CAQH&quot;)</expression>
    </formulas>
    <formulas>
        <name>fx_Recred_External_Id</name>
        <dataType>String</dataType>
        <expression>LEFT({!Loop_Providers.External_Id__c} &amp; &quot;-RECRED-&quot; &amp; TEXT(YEAR({!$Flow.CurrentDate})) &amp; TEXT(MONTH({!$Flow.CurrentDate})) &amp; TEXT(DAY({!$Flow.CurrentDate})), 40)</expression>
    </formulas>
    <interviewLabel>Cred Recred Nightly {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Cred Recred Nightly</label>
    <loops>
        <name>Loop_Providers</name>
        <label>Loop Expiring Providers</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <collectionReference>Get_Expiring_Providers</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Get_Open_Recred</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Recred_App</name>
        <label>Create Recred Application</label>
        <locationX>264</locationX>
        <locationY>863</locationY>
        <connector>
            <targetReference>Loop_Providers</targetReference>
        </connector>
        <inputReference>varNewApp</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Expiring_Providers</name>
        <label>Get Expiring Providers</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Providers</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Recred_Due_Date__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>fx_Due_Horizon</elementReference>
            </value>
        </filters>
        <filters>
            <field>Recred_Due_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Provider__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Open_Recred</name>
        <label>Get Open Recred Application</label>
        <locationX>396</locationX>
        <locationY>539</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Open_Recred</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND (3 OR 4 OR 5 OR 6)</filterLogic>
        <filters>
            <field>Provider__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Loop_Providers.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Application_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Recred</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Draft</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Incomplete</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>In_Review</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Pending_Committee</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Credentialing_Application__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Status__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Expiring_Providers</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-08-13</startDate>
            <startTime>10:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varNewApp</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Credentialing_Application__c</objectType>
    </variables>
</Flow>
