<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Set_Status_Incomplete</name>
        <label>Set Status Intake</label>
        <locationX>308</locationX>
        <locationY>395</locationY>
        <assignmentItems>
            <assignToReference>$Record.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Intake</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Has_Incomplete_Required</name>
        <label>Has Incomplete Required Items?</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>All Complete — allow In Review</defaultConnectorLabel>
        <rules>
            <name>Incomplete_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Incomplete_Items</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Status_Incomplete</targetReference>
            </connector>
            <label>Incomplete Found</label>
        </rules>
    </decisions>
    <description>When Status moves to In Review, force Intake if required checklist items remain open. Chase Flow picks up Intake.</description>
    <interviewLabel>Cred Checklist Gate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Cred Checklist Gate</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Incomplete_Items</name>
        <label>Get Incomplete Required Items</label>
        <locationX>182</locationX>
        <locationY>179</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Incomplete_Required</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Credentialing_Application__c</field>
            <operator>EqualTo</operator>
