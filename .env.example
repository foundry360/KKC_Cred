# Supabase (project: jkfzojmltfxwgrkrrpsf)
NEXT_PUBLIC_SUPABASE_URL=https://jkfzojmltfxwgrkrrpsf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — used by seed / admin scripts (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Hybrid cred assist (Claude). Optional — falls back to local heuristics if unset.
ANTHROPIC_API_KEY=
CRED_ASSIST_MODEL=claude-sonnet-4-20250514
CRED_ASSIST_SECRET=

# PSV: NPPES is LIVE (no key). Florida / OIG / Board / DEA adapters are POC-labeled.
# Apply schema: supabase login && supabase link --project-ref jkfzojmltfxwgrkrrpsf && npm run db:push
# Demo data: npm run seed:psv-demo

# Portal → Salesforce sync (runs after portal submit).
# Local: SF_TARGET_ORG + `sf org login` (REST uses CLI token).
# Vercel/cloud: set Connected App / External Client App OAuth below.
SF_TARGET_ORG=cred-poc
SF_SYNC_VIA_CLI=true
SF_API_VERSION=61.0
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_LOGIN_URL=https://login.salesforce.com
SF_AUTH_FLOW=client_credentials
# Optional password flow fallback:
# SF_USERNAME=
# SF_PASSWORD=
